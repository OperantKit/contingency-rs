{
  "name": "@operantkit/jspsych-plugin-contingency",
  "version": "0.0.0",
  "description": "jsPsych plugin that runs reinforcement schedules from the contingency engine (WebAssembly)",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    "import": "./dist/index.js",
    "require": "./dist/index.cjs"
  },
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.browser.min.js",
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "wasm:build": "cd .. && wasm-pack build --target web --release --out-dir pkg",
    "build": "rollup --config && cp ../pkg/contingency_bg.wasm dist/",
    "test:e2e": "npm run build && playwright test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OperantKit/contingency-rs",
    "directory": "jspsych"
  },
  "dependencies": {
    "contingency": "file:../pkg"
  },
  "peerDependencies": {
    "jspsych": ">=8.0.0"
  },
  "devDependencies": {
    "@jspsych/config": "^3.4.0",
    "@playwright/test": "^1.60.0",
    "jspsych": "^8.3.0"
  }
}
